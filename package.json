{
  "name": "nagishon",
  "version": "1.0.0",
  "description": "Free, MIT-licensed, framework-agnostic accessibility toolbar (תפריט נגישות), Hebrew/RTL-first.",
  "keywords": [
    "accessibility",
    "a11y",
    "toolbar",
    "widget",
    "hebrew",
    "rtl",
    "wcag",
    "israel",
    "5568",
    "נגישות"
  ],
  "homepage": "https://nagishon-site.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roizlotolov/nagishon.git"
  },
  "bugs": {
    "url": "https://github.com/Roizlotolov/nagishon/issues"
  },
  "author": "Roi Zlotolov",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "dist/nagishon.iife.js",
  "jsdelivr": "dist/nagishon.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./prepaint": {
      "types": "./dist/prepaint.d.ts",
      "import": "./dist/prepaint.module.js"
    },
    "./iife": "./dist/nagishon.iife.js",
    "./package.json": "./package.json",
    "./prepaint.js": "./dist/prepaint.js"
  },
  "files": [
    "dist",
    "README*.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite demo",
    "build": "rm -rf dist && tsup",
    "build:demo": "vite build demo && node scripts/copy-dist.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "size": "size-limit",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run size",
    "preview": "npm run build && npm run build:demo && vite preview demo --port 4173 --strictPort"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "path": "dist/nagishon.iife.js",
      "limit": "18 KB",
      "gzip": true
    },
    {
      "path": "dist/prepaint.js",
      "limit": "1.2 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@size-limit/file": "14.3.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "size-limit": "14.3.0",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
